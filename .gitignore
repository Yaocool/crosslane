# Rust build artifacts and editor backups
/target/
**/*.rs.bk
*.pdb
.crosslane-dev/
# Keep credentials from pre-rename checkouts ignored during migration.
.kproxy-dev/

# Local environment files (keep documented templates in version control)
.env
.env.*
!.env.example
!.env.*.example
/deploy/.crosslane-image
/deploy/.crosslane-image.tmp.*
/deploy/.kproxy-image
/deploy/.kproxy-image.tmp.*

# Local logs and OS metadata
*.log
.DS_Store
Thumbs.db

# IDE-local state. Never share editor-local settings.
.idea/
.vscode/

# AI-assisted development: local settings, indexes, caches, and session state.
# Keep shareable project instructions such as AGENTS.md and CLAUDE.md tracked.
.claude/*
.cursor/
.windsurf/
.continue/
.roo/
.codeium/
.aider*
.opencode/
.gemini/
.augment/
.codegraph/
.remember/
