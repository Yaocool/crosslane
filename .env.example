# Copy this file to .env on first setup; preserve any existing local settings.
# crosslaned and crosslane business commands load it. CLI help, guide, completions,
# and version run before environment loading and do not require this file.
# They search from the current directory upward. Variables already present in
# the process environment take precedence over values in this file.

# Development configuration and data root.
# config.toml, accounts.json, daily.json, stats.json, logs, and the generated
# admin.sock are stored below this directory. Remove this variable to use the
# standard XDG configuration, data, and runtime locations.
# Relative paths are resolved from the process working directory, not from this
# file's directory. Use an absolute path if the CLI and daemon run from different
# directories. Configuration and data location details:
# docs/startup-and-debugging.md
CROSSLANE_HOME=.crosslane-dev

# Tracing filter. This value enables debug logs for the daemon and the main Kiro
# request/scheduling crates. Use "info" for quieter local output.
RUST_LOG=crosslaned=debug,crosslane_kiro=debug,crosslane_pool=debug

# Emit a Rust backtrace for panics and supported runtime errors.
# Use "full" instead of "1" for a more verbose backtrace.
RUST_BACKTRACE=1

# All variables below are optional. Uncomment only when needed.

# Local Docker Compose source builds only: limit concurrent Cargo compilation
# jobs when using docker-compose.build.yml. Production pulls prebuilt images.
# CARGO_BUILD_JOBS=1

# Override the listening port of a configured proxy service whose port matches
# server.port. This does not create a proxy service. It takes precedence until
# crosslaned is restarted without the variable. Service views and automatic
# port allocation use the effective listening port. The default server.port is 5580.
# CROSSLANE_HTTP_PORT=5581

# Set exactly to 1 to prevent every configured proxy service from listening.
# This does not disable or delete their configuration. The Unix administration
# socket remains active, so crosslane CLI commands still work.
# CROSSLANE_DISABLE_HTTP=1

# Override the Unix socket used by the crosslane CLI.
# This variable does not change the socket on which crosslaned listens. To move the
# daemon socket, edit admin.socket in config.toml and restart crosslaned.
# CROSSLANE_ADMIN_SOCKET=.crosslane-dev/admin.sock

# Override the CodeWhisperer generation endpoint.
# Intended for integration tests or controlled upstream proxies. Production
# deployments should normally use the built-in endpoint.
# CROSSLANE_CODEWHISPERER_URL=https://codewhisperer.us-east-1.amazonaws.com/generateAssistantResponse

# Override the Amazon Q generation endpoint.
# Intended for integration tests or controlled upstream proxies. Production
# deployments should normally use the built-in endpoint.
# CROSSLANE_AMAZONQ_URL=https://q.us-east-1.amazonaws.com/generateAssistantResponse

# Override the Kiro MCP endpoint used by proxy-executed Web Search. When unset,
# the account region selects https://runtime.{region}.kiro.dev/mcp.
# CROSSLANE_MCP_URL=https://runtime.us-east-1.kiro.dev/mcp

# Override regional Kiro generation and management RPC endpoints. Both support
# the {region} placeholder. Intended for integration tests or controlled proxies.
# CROSSLANE_RUNTIME_URL=https://runtime.{region}.kiro.dev
# CROSSLANE_MANAGEMENT_URL=https://management.{region}.kiro.dev/

# CLI input for `crosslane account add-api-key`. Prefer --key-stdin for a key stored
# in a protected file. Setting this only on crosslaned does not import an account.
# This upstream key is distinct from a client-facing proxy API key.
# KIRO_API_KEY=ksk_replace_me

# Bridge-network Docker deployments only: expose this container port through
# socat and forward it to 127.0.0.1:${CROSSLANE_HTTP_PORT:-5580}. The default Compose
# file uses host networking and does not need this compatibility forwarder. The
# crosslaned and crosslane binaries do not read CROSSLANE_FORWARD_PORT directly.
# CROSSLANE_FORWARD_PORT=5580

# SSO/Chromium only: disable the Chromium sandbox.
# The runtime-full Docker image sets this because it already runs inside a
# container. Do not enable it for a normal host installation unless the security
# implications have been reviewed.
# CROSSLANE_CHROMIUM_NO_SANDBOX=1

# Optional editor used by `crosslane config edit`. VISUAL takes precedence over EDITOR;
# otherwise crosslane detects vi, vim, or nano. Docker images include vi.
# VISUAL="code --wait"
# EDITOR=vim
