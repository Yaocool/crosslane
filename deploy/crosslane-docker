#!/bin/sh
# Managed by crosslane's install-crosslane-wrapper.sh.
set -eu

fail() {
  echo "crosslane: $*" >&2
  exit 1
}

usage_error() {
  echo "crosslane: $*" >&2
  exit 2
}

# Only override the container's shell default when the host explicitly sets it.
# Preserve argument boundaries and keep the value out of the Docker command line.
exec_cli() {
  docker_action="$1"
  shift
  if [ "${CROSSLANE_PROVIDER+x}" = x ]; then
    exec docker "$docker_action" -e CROSSLANE_PROVIDER "$@"
  fi
  exec docker "$docker_action" "$@"
}

lifecycle_action=""
navigation_only=0
uninstall_yes=0
uninstall_backup_dir=""
uninstall_retention="ask"
top_level_command=""
expect_socket_value=0
expect_provider_value=0
help_requested=0
for argument in "$@"; do
  if [ "$expect_socket_value" -eq 1 ] || [ "$expect_provider_value" -eq 1 ]; then
    expect_socket_value=0
    expect_provider_value=0
    continue
  fi
  case "$argument" in
    -h|--help)
      # Clap stops parsing at an explicit help flag. Leave everything after it
      # to the container CLI so that root-vs-command help stays authoritative.
      help_requested=1
      break
      ;;
    --json)
      ;;
    --socket)
      expect_socket_value=1
      ;;
    --socket=*)
      ;;
    --provider|-p)
      expect_provider_value=1
      ;;
    --provider=*|-p?*)
      ;;
    *)
      if [ -z "$top_level_command" ]; then
        top_level_command="$argument"
      fi
      ;;
  esac
done

validate_simple_lifecycle_args() {
  expected_action="$1"
  shift
  seen_action=0
  seen_json=0
  seen_socket=0
  expect_socket_value=0
  options_ended=0
  for argument in "$@"; do
    if [ "$expect_socket_value" -eq 1 ]; then
      case "$argument" in
        -) ;;
        -?*) usage_error "--socket requires a path" ;;
      esac
      expect_socket_value=0
      continue
    fi
    if [ "$options_ended" -eq 1 ]; then
      usage_error "usage: crosslane $expected_action"
    fi
    case "$argument" in
      -h|--help)
        navigation_only=1
        return 0
        ;;
      --json)
        [ "$seen_json" -eq 0 ] || usage_error "--json cannot be used multiple times"
        seen_json=1
        ;;
      --socket)
        [ "$seen_socket" -eq 0 ] || usage_error "--socket cannot be used multiple times"
        seen_socket=1
        expect_socket_value=1
        ;;
      --socket=*)
        [ "$seen_socket" -eq 0 ] || usage_error "--socket cannot be used multiple times"
        seen_socket=1
        ;;
      --)
        [ "$seen_action" -eq 1 ] || usage_error "usage: crosslane $expected_action"
        options_ended=1
        ;;
      "$expected_action")
        [ "$seen_action" -eq 0 ] || usage_error "usage: crosslane $expected_action"
        seen_action=1
        ;;
      *)
        usage_error "usage: crosslane $expected_action"
        ;;
    esac
  done
  [ "$expect_socket_value" -eq 0 ] || usage_error "--socket requires a path"
  [ "$seen_action" -eq 1 ] || usage_error "usage: crosslane $expected_action"
}

validate_uninstall_args() {
  seen_action=0
  seen_json=0
  seen_socket=0
  seen_yes=0
  seen_backup_dir=0
  seen_keep_backup=0
  seen_delete_backup=0
  expect_socket_value=0
  expect_backup_dir=0
  options_ended=0

  for argument in "$@"; do
    if [ "$expect_socket_value" -eq 1 ]; then
      case "$argument" in
        -) ;;
        -?*) usage_error "--socket requires a path" ;;
      esac
      expect_socket_value=0
      continue
    fi
    if [ "$expect_backup_dir" -eq 1 ]; then
      case "$argument" in
        -) ;;
        -?*) usage_error "--backup-dir requires a path" ;;
      esac
      [ -n "$argument" ] || usage_error "--backup-dir cannot be empty"
      uninstall_backup_dir="$argument"
      expect_backup_dir=0
      continue
    fi
    if [ "$options_ended" -eq 1 ]; then
      usage_error "usage: crosslane uninstall"
    fi

    case "$argument" in
      -h|--help)
        navigation_only=1
        return 0
        ;;
      --json)
        [ "$seen_json" -eq 0 ] || usage_error "--json cannot be used multiple times"
        seen_json=1
        ;;
      --socket)
        [ "$seen_socket" -eq 0 ] || usage_error "--socket cannot be used multiple times"
        seen_socket=1
        expect_socket_value=1
        ;;
      --socket=*)
        [ "$seen_socket" -eq 0 ] || usage_error "--socket cannot be used multiple times"
        seen_socket=1
        ;;
      uninstall)
        [ "$seen_action" -eq 0 ] || usage_error "usage: crosslane uninstall"
        seen_action=1
        ;;
      --yes|-y)
        [ "$seen_yes" -eq 0 ] || usage_error "--yes cannot be used multiple times"
        seen_yes=1
        uninstall_yes=1
        ;;
      --backup-dir)
        [ "$seen_backup_dir" -eq 0 ] || usage_error "--backup-dir cannot be used multiple times"
        seen_backup_dir=1
        expect_backup_dir=1
        ;;
      --backup-dir=*)
        [ "$seen_backup_dir" -eq 0 ] || usage_error "--backup-dir cannot be used multiple times"
        seen_backup_dir=1
        uninstall_backup_dir="${argument#*=}"
        [ -n "$uninstall_backup_dir" ] || usage_error "--backup-dir cannot be empty"
        ;;
      --keep-backup)
        [ "$seen_keep_backup" -eq 0 ] || usage_error "--keep-backup cannot be used multiple times"
        [ "$seen_delete_backup" -eq 0 ] || \
          usage_error "--keep-backup conflicts with --delete-backup"
        seen_keep_backup=1
        uninstall_retention="keep"
        ;;
      --delete-backup)
        [ "$seen_delete_backup" -eq 0 ] || usage_error "--delete-backup cannot be used multiple times"
        [ "$seen_keep_backup" -eq 0 ] || \
          usage_error "--delete-backup conflicts with --keep-backup"
        seen_delete_backup=1
        uninstall_retention="delete"
        ;;
      --)
        [ "$seen_action" -eq 1 ] || usage_error "usage: crosslane uninstall"
        options_ended=1
        ;;
      *)
        usage_error "unknown uninstall option: $argument"
        ;;
    esac
  done

  [ "$expect_socket_value" -eq 0 ] || usage_error "--socket requires a path"
  [ "$expect_backup_dir" -eq 0 ] || usage_error "--backup-dir requires a path"
  [ "$seen_action" -eq 1 ] || usage_error "usage: crosslane uninstall"
}

case "$top_level_command" in
  restart|stop)
    validate_simple_lifecycle_args "$top_level_command" "$@"
    if [ "$navigation_only" -eq 0 ]; then
      lifecycle_action="$top_level_command"
    fi
    ;;
  uninstall)
    validate_uninstall_args "$@"
    if [ "$navigation_only" -eq 0 ]; then
      lifecycle_action="$top_level_command"
    fi
    ;;
esac

if ! command -v docker >/dev/null 2>&1; then
  if [ "$navigation_only" -eq 1 ]; then
    case "$top_level_command" in
      restart|stop)
        echo "Usage: crosslane $top_level_command [--help]"
        ;;
      uninstall)
        echo 'Usage: crosslane uninstall [--yes] [--backup-dir PATH] [--keep-backup|--delete-backup]'
        echo '删除 Docker 服务前必定备份数据；默认备份到 ~/.crosslane/backups，源码目录保留。'
        ;;
    esac
    echo 'Docker 当前不可用；启动 Docker 后可查看完整命令帮助。'
    exit 0
  fi
  fail "docker command not found"
fi

if [ -n "${CROSSLANE_DOCKER_CONTAINER:-}" ]; then
  container_id="$CROSSLANE_DOCKER_CONTAINER"
else
  include_stopped="--all"
  if [ -n "${CROSSLANE_COMPOSE_PROJECT:-}" ]; then
    containers="$(docker ps $include_stopped \
      --filter 'label=io.crosslane.role=daemon' \
      --filter "label=com.docker.compose.project=${CROSSLANE_COMPOSE_PROJECT}" \
      --format '{{.ID}}')"
  else
    containers="$(docker ps $include_stopped \
      --filter 'label=io.crosslane.role=daemon' \
      --format '{{.ID}}')"
  fi

  container_count="$(printf '%s\n' "$containers" | awk 'NF { count++ } END { print count + 0 }')"
  case "$container_count" in
    0)
      fail "no crosslane daemon container found"
      ;;
    1)
      container_id="$(printf '%s\n' "$containers" | awk 'NF { print; exit }')"
      ;;
    *)
      fail "multiple daemon containers found; set CROSSLANE_COMPOSE_PROJECT or CROSSLANE_DOCKER_CONTAINER"
      ;;
  esac
fi

wait_until_healthy() {
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    state="$(docker inspect --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' "$container_id" 2>/dev/null || true)"
    case "$state" in
      "running healthy"|running|"running ") return 0 ;;
      "exited "*|"dead "*) return 1 ;;
    esac
    attempt=$((attempt + 1))
    sleep 2
  done
  return 1
}

container_state() {
  docker inspect --format '{{.State.Status}}' "$container_id"
}

create_data_backup() {
  umask 077
  mkdir -p "$backup_root" || return 1
  backup_root="$(CDPATH= cd "$backup_root" 2>/dev/null && pwd -P)" || return 1
  backup_name="crosslane-backup-${project}-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  backup_path="$backup_root/$backup_name"
  backup_partial="${backup_path}.partial"
  mkdir "$backup_partial" || return 1
  docker cp "${container_id}:/var/lib/crosslane/." "$backup_partial" || return 1
  [ -f "$backup_partial/config.toml" ] || return 1
  {
    printf 'project=%s\n' "$project"
    printf 'container=%s\n' "$container_id"
    printf 'volume=%s\n' "$data_volume"
    printf 'image=%s\n' "$image_ref"
    printf 'created_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$backup_partial/BACKUP_MANIFEST.txt" || return 1
  mv "$backup_partial" "$backup_path" || return 1
}

remove_managed_wrapper() {
  wrapper_path="$0"
  case "$wrapper_path" in
    /*) ;;
    *) wrapper_path="$(command -v "$wrapper_path" 2>/dev/null || printf '%s' "$wrapper_path")" ;;
  esac
  case "$wrapper_path" in
    */crosslane)
      if grep -qF "Managed by crosslane's install-crosslane-wrapper.sh." "$wrapper_path" 2>/dev/null; then
        if rm -f "$wrapper_path"; then
          echo "已删除宿主机命令 $wrapper_path"
        else
          echo "crosslane: 无法删除宿主机命令 ${wrapper_path}，请手工删除" >&2
          return 1
        fi
      fi
      ;;
    *)
      echo "宿主机 wrapper 未删除（当前入口不是名为 crosslane 的已安装文件）：$wrapper_path"
      ;;
  esac
}

case "$lifecycle_action" in
  restart)
    echo "正在重启 crosslane 容器 $container_id ..."
    if [ "$(container_state)" = "running" ]; then
      docker restart --time 30 "$container_id" >/dev/null
    else
      docker start "$container_id" >/dev/null
    fi
    if wait_until_healthy; then
      echo "crosslane 已重启并通过健康检查"
      exit 0
    fi
    docker logs --tail 50 "$container_id" >&2 || true
    fail "容器重启后未在 60 秒内恢复健康"
    ;;
  stop)
    if [ "$(container_state)" = "running" ]; then
      docker stop --time 30 "$container_id" >/dev/null
      echo 'crosslane 已停止；可用 `crosslane restart` 重新启动'
    else
      echo 'crosslane 已处于停止状态；可用 `crosslane restart` 重新启动'
    fi
    exit 0
    ;;
  uninstall)
    project="$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project" }}' "$container_id")"
    case "$project" in
      ""|"<no value>") project="${CROSSLANE_COMPOSE_PROJECT:-crosslane}" ;;
    esac
    data_volume="$(docker inspect --format '{{range .Mounts}}{{if and (eq .Type "volume") (eq .Destination "/var/lib/crosslane")}}{{.Name}}{{end}}{{end}}' "$container_id")"
    image_ref="$(docker inspect --format '{{.Config.Image}}' "$container_id")"
    backup_root="$uninstall_backup_dir"
    if [ -z "$backup_root" ]; then
      backup_root="${CROSSLANE_BACKUP_DIR:-}"
    fi
    if [ -z "$backup_root" ]; then
      if [ -n "${HOME:-}" ]; then
        backup_root="$HOME/.crosslane/backups"
      else
        backup_root="$(pwd)/crosslane-backups"
      fi
    fi
    case "$backup_root" in
      /*) ;;
      *) backup_root="$(pwd)/$backup_root" ;;
    esac

    echo "即将完全卸载 crosslane Compose 项目 ${project}："
    echo "  容器：$container_id"
    if [ -n "$data_volume" ]; then
      echo "  数据卷：${data_volume}（配置、账号、统计和日志会永久删除）"
    fi
    if [ -n "$image_ref" ]; then
      echo "  镜像：${image_ref}（未被其他容器使用时删除）"
    fi
    echo "  卸载前备份到宿主机目录：$backup_root"
    echo "  宿主机 crosslane wrapper（源码目录保留）"

    if [ "$uninstall_yes" -ne 1 ]; then
      printf '请输入 Compose 项目名 %s 以确认：' "$project"
      IFS= read -r confirmation || fail "无法读取确认输入"
      if [ "$confirmation" != "$project" ]; then
        echo "已取消卸载"
        exit 0
      fi
    fi

    if [ "$uninstall_retention" = "ask" ]; then
      if [ "$uninstall_yes" -eq 1 ]; then
        uninstall_retention="keep"
      else
        printf '卸载完成后是否保留备份？[Y/n] '
        IFS= read -r keep_answer || fail "无法读取备份保留选择"
        case "$keep_answer" in
          n|N|no|NO|No) uninstall_retention="delete" ;;
          *) uninstall_retention="keep" ;;
        esac
      fi
    fi

    was_running=0
    if [ "$(container_state)" = "running" ]; then
      was_running=1
      docker stop --time 30 "$container_id" >/dev/null
    fi

    echo "正在备份 /var/lib/crosslane ..."
    if ! create_data_backup; then
      if [ "$was_running" -eq 1 ]; then
        docker start "$container_id" >/dev/null || true
        echo "原 crosslane 容器已重新启动" >&2
      fi
      if [ -n "${backup_partial:-}" ]; then
        case "$backup_partial" in
          "$backup_root"/crosslane-backup-*.partial) rm -rf -- "$backup_partial" || true ;;
        esac
      fi
      fail "备份失败，已中止卸载且未删除原数据；请检查备份目录 $backup_root"
    fi
    echo "数据备份已完成：$backup_path"

    docker rm "$container_id" >/dev/null
    cleanup_failed=0
    if [ -n "$data_volume" ]; then
      if docker volume rm "$data_volume" >/dev/null; then
        echo "已删除数据卷 $data_volume"
      else
        echo "crosslane: 数据卷 ${data_volume} 仍被占用，未删除" >&2
        cleanup_failed=1
      fi
    fi
    if [ -n "$image_ref" ]; then
      image_users="$(docker ps --all --quiet --filter "ancestor=$image_ref")"
      if [ -n "$image_users" ]; then
        echo "镜像 $image_ref 仍被其他容器使用，已保留"
      elif docker image rm "$image_ref" >/dev/null; then
        echo "已删除镜像 $image_ref"
      else
        echo "crosslane: 无法删除镜像 ${image_ref}，请检查 Docker 镜像引用" >&2
        cleanup_failed=1
      fi
    fi
    if [ "$cleanup_failed" -ne 0 ]; then
      fail "服务容器已删除，但部分资源清理失败；备份 $backup_path 和宿主机 wrapper 已保留"
    fi

    backup_delete_failed=0
    if [ "$uninstall_retention" = "delete" ]; then
      case "$backup_path" in
        "$backup_root"/crosslane-backup-*) ;;
        *) fail "拒绝删除范围异常的备份路径：$backup_path" ;;
      esac
      if rm -rf -- "$backup_path"; then
        echo "已按用户选择删除备份：$backup_path"
      else
        echo "crosslane: 无法删除备份 ${backup_path}，备份已保留" >&2
        backup_delete_failed=1
      fi
    else
      echo "备份已保留：$backup_path"
    fi
    remove_managed_wrapper || exit 1
    if [ "$backup_delete_failed" -ne 0 ]; then
      fail "crosslane 已卸载，但备份删除失败"
    fi
    echo "crosslane 已完全卸载"
    exit 0
    ;;
esac

if [ "$(container_state)" != "running" ]; then
  [ "$navigation_only" -eq 1 ] || [ -z "$lifecycle_action" ] || \
    fail "cannot run lifecycle action against container $container_id"
  image_id="$(docker inspect --format '{{.Image}}' "$container_id" 2>/dev/null || true)"
  [ -n "$image_id" ] || fail "cannot resolve the image for stopped container $container_id"
  if ! docker run \
    --rm \
    --pull never \
    --network none \
    --read-only \
    --no-healthcheck \
    -e CROSSLANE_WRAPPER_LOCAL_ONLY=1 \
    --entrypoint /usr/local/bin/crosslane \
    "$image_id" help --all >/dev/null 2>&1; then
    fail "cannot use stopped container image $image_id for offline CLI navigation; the image is unavailable or too old, so restart the service or deploy a matching image and wrapper"
  fi
  exec_cli run \
    --rm \
    --pull never \
    --network none \
    --read-only \
    --no-healthcheck \
    -e CROSSLANE_WRAPPER_LOCAL_ONLY=1 \
    --entrypoint /usr/local/bin/crosslane \
    "$image_id" "$@"
fi

# Tell log path commands where the persistent data directory is mounted on the
# Docker host. Avoid an extra inspect call for unrelated commands.
CROSSLANE_WRAPPER_HOST_DATA_DIR=""
for argument in "$@"; do
  if [ "$argument" = "logs" ]; then
    CROSSLANE_WRAPPER_HOST_DATA_DIR="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/var/lib/crosslane"}}{{.Source}}{{end}}{{end}}' "$container_id" 2>/dev/null || true)"
    break
  fi
done
export CROSSLANE_WRAPPER_HOST_DATA_DIR

# A host path is not visible inside an already-running container. For account CSV
# imports, stream a readable host file through stdin and tell the container CLI
# to consume that stream. Container paths continue to work when no host file
# with the supplied name exists.
is_account_batch=0
top_level_command=""
account_command=""
expect_socket_value=0
expect_provider_value=0
for argument in "$@"; do
  if [ "$expect_socket_value" -eq 1 ] || [ "$expect_provider_value" -eq 1 ]; then
    expect_socket_value=0
    expect_provider_value=0
    continue
  fi
  case "$argument" in
    --json) continue ;;
    --socket) expect_socket_value=1; continue ;;
    --socket=*) continue ;;
    --provider|-p) expect_provider_value=1; continue ;;
    --provider=*|-p?*) continue ;;
  esac
  if [ -z "$top_level_command" ]; then
    top_level_command="$argument"
  elif [ -z "$account_command" ]; then
    account_command="$argument"
    break
  fi
done
if [ "$top_level_command" = "account" ]; then
  case "$account_command" in
    add-sso|add) is_account_batch=1 ;;
  esac
fi

host_batch_file=""
if [ "$is_account_batch" -eq 1 ] && [ "$help_requested" -eq 0 ]; then
  expect_batch_file=0
  for argument in "$@"; do
    if [ "$expect_batch_file" -eq 1 ]; then
      host_batch_file="$argument"
      break
    fi
    case "$argument" in
      --batch) expect_batch_file=1 ;;
      --batch=*) host_batch_file="${argument#*=}"; break ;;
    esac
  done
fi

if [ -n "$host_batch_file" ] && [ "$host_batch_file" != "-" ] && [ -e "$host_batch_file" ]; then
  [ -f "$host_batch_file" ] || fail "host batch path is not a regular file: $host_batch_file"
  [ -r "$host_batch_file" ] || fail "host batch file is not readable: $host_batch_file"
  exec_cli exec -i \
    -e CROSSLANE_WRAPPER_BATCH_STDIN=1 \
    -e CROSSLANE_WRAPPER_HOST_DATA_DIR \
    "$container_id" /usr/local/bin/crosslane "$@" < "$host_batch_file"
fi

if [ -t 0 ] && [ -t 1 ]; then
  # Full-screen terminal programs such as vi need the host terminal type to
  # interpret cursor and function keys correctly inside the container.
  case "${TERM:-}" in
    ""|dumb) terminal_type="xterm-256color" ;;
    *) terminal_type="$TERM" ;;
  esac
  # Minimal images do not necessarily contain host-specific terminfo entries
  # such as xterm-kitty or wezterm. Fall back to the broadly supported xterm
  # definition instead of letting Vim interpret cursor-key escape sequences as
  # literal input.
  if ! docker exec "$container_id" infocmp "$terminal_type" >/dev/null 2>&1; then
    terminal_type="xterm-256color"
  fi
  editor="${EDITOR:-vim}"
  visual="${VISUAL:-$editor}"
  exec_cli exec -it \
    -e "TERM=$terminal_type" \
    -e "EDITOR=$editor" \
    -e "VISUAL=$visual" \
    -e CROSSLANE_WRAPPER_HOST_DATA_DIR \
    "$container_id" /usr/local/bin/crosslane "$@"
else
  exec_cli exec -i \
    -e CROSSLANE_WRAPPER_HOST_DATA_DIR \
    "$container_id" /usr/local/bin/crosslane "$@"
fi
